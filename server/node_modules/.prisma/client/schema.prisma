datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String @id @default(uuid())
  code        String @unique // MINISTER_POLICYMAKER, PROJECT_MANAGER, FIELD_OFFICER, CONTRACTOR
  displayName String
  users       User[]
}

model Ministry {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
  users    User[]
}

model User {
  id            String           @id @default(uuid())
  name          String
  email         String           @unique
  passwordHash  String
  roleId        String
  role          Role             @relation(fields: [roleId], references: [id])
  ministryId    String?
  ministry      Ministry?        @relation(fields: [ministryId], references: [id])
  agencyId      String?
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  interventions Intervention[]   @relation("AssignedInterventions")
  fieldUpdates  FieldUpdate[]
  tasks         ContractorTask[]
  targets       MonthlyTarget[]
  auditLogs     AuditLog[]
}

model Project {
  id          String    @id @default(uuid())
  projectCode Int       @unique
  projectId   String
  projectName String
  ministryId  String?
  ministry    Ministry? @relation(fields: [ministryId], references: [id])
  sector      String
  state       String
  agency      String
  status      String    @default("ACTIVE")
  latitude    Float?
  longitude   Float?
  source      String    @default("PAIMANA_CUF")
  createdAt   DateTime  @default(now())

  snapshots                 ProjectSnapshot[]
  predictions               RiskPrediction[]
  warnings                  EarlyWarning[]
  interventions             Intervention[]
  fieldUpdates              FieldUpdate[]
  tasks                     ContractorTask[]
  targets                   MonthlyTarget[]
  milestones                Milestone[]
  enrichmentRecommendations EnrichmentRecommendation[]
  enrichmentCollectionPlans EnrichmentCollectionPlan[]
  enrichmentObservations    EnrichmentObservation[]
  enrichmentCoverages       EnrichmentCoverage[]
}

model ProjectSnapshot {
  id                         String   @id @default(uuid())
  projectId                  String
  project                    Project  @relation(fields: [projectId], references: [id])
  reportDate                 String
  originalCost               Float
  revisedCost                Float
  cumulativeExpenditure      Float
  physicalProgress           Float
  expenditurePercentOriginal Float
  projectAgeMonths           Float
  remainingPlannedDuration   Float
  plannedDuration            Float
  notStartedFlag             Float
  genuineOverdueFlag         Float
  ministryEncoded            Float
  sectorEncoded              Float
  stateEncoded               Float
  costOverrunPercent         Float?
  delayMonths                Float?
  createdAt                  DateTime @default(now())

  predictions RiskPrediction[]
}

model RiskPrediction {
  id                     String          @id @default(uuid())
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id])
  snapshotId             String
  snapshot               ProjectSnapshot @relation(fields: [snapshotId], references: [id])
  modelVersion           String          @default("CUF-XGB-v1")
  costPrediction         String
  costProbabilitiesJson  String
  delayPrediction        String
  delayProbabilitiesJson String
  riskProbability        Float
  riskLevel              String // Low, Medium, High
  scorePercentage        Float
  createdAt              DateTime        @default(now())

  drivers  RiskDriver[]
  warnings EarlyWarning[]
}

model RiskDriver {
  id           String         @id @default(uuid())
  predictionId String
  prediction   RiskPrediction @relation(fields: [predictionId], references: [id])
  modelType    String // RISK, COST, DELAY
  feature      String
  featureValue Float
  shapValue    Float
  absShapValue Float
  rank         Int
  direction    String // increasing risk, reducing risk
  explanation  String
  prescription String
}

model EarlyWarning {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  predictionId String?
  prediction   RiskPrediction? @relation(fields: [predictionId], references: [id])
  category     String
  severity     String // CRITICAL, HIGH, MEDIUM, LOW
  title        String
  message      String
  basis        String
  status       String          @default("DETECTED") // DETECTED, ACKNOWLEDGED, ACTION_ASSIGNED, IN_PROGRESS, VERIFICATION_REQUIRED, RESOLVED, ESCALATED
  detectedAt   DateTime        @default(now())

  interventions Intervention[]
}

model Intervention {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  warningId      String?
  warning        EarlyWarning? @relation(fields: [warningId], references: [id])
  driver         String
  recommendation String
  priority       String        @default("HIGH") // HIGH, MEDIUM, LOW
  assignedRole   String?
  assignedUserId String?
  assignedUser   User?         @relation("AssignedInterventions", fields: [assignedUserId], references: [id])
  deadline       String?
  status         String        @default("PENDING") // PENDING, IN_PROGRESS, VERIFIED, RESOLVED, ESCALATED
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model FieldUpdate {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  fieldOfficerId     String
  fieldOfficer       User     @relation(fields: [fieldOfficerId], references: [id])
  updateDate         String
  physicalProgress   Float
  milestoneStatus    String
  issueType          String?
  issueDescription   String?
  evidenceUrl        String?
  remarks            String?
  verificationStatus String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  createdAt          DateTime @default(now())
}

model ContractorTask {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id])
  task         String
  target       Float
  completed    Float
  deadline     String
  status       String   @default("IN_PROGRESS") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  remarks      String?
  createdAt    DateTime @default(now())
}

model MonthlyTarget {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id])
  month        String
  target       Float
  achieved     Float
  createdAt    DateTime @default(now())
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  plannedDate String
  actualDate  String?
  status      String   @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, DELAYED
  createdAt   DateTime @default(now())
}

model DataUpload {
  id              String                @id @default(uuid())
  uploadedBy      String
  filename        String
  rowsReceived    Int
  rowsValid       Int
  rowsInvalid     Int
  projectsUpdated Int
  risksDetected   Int
  status          String                @default("COMPLETED")
  createdAt       DateTime              @default(now())
  errors          DataValidationError[]
}

model DataValidationError {
  id        String     @id @default(uuid())
  uploadId  String
  upload    DataUpload @relation(fields: [uploadId], references: [id])
  rowNumber Int
  field     String
  errorType String
  message   String
}

model ModelVersion {
  id              String   @id @default(uuid())
  name            String
  type            String // COST, DELAY, RISK
  version         String   @unique
  metricsJson     String
  featureListJson String
  createdAt       DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  entity       String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())
}

model EnrichmentFeatureCatalog {
  id              String   @id @default(uuid())
  featureCode     String   @unique
  featureName     String
  description     String
  targetRelevance String // COST, DELAY, RISK, MULTI
  collectionRole  String // FIELD_OFFICER, CONTRACTOR, PROJECT_MANAGER
  cadence         String // DAILY, WEEKLY, MONTHLY
  inputType       String // NUMBER, TEXT, BOOLEAN, RATING
  unit            String
  sourceType      String // FIELD_UPDATE, CONTRACTOR_TASK, INSPECTION, SITE_LOG
  sectorScope     String // ALL, ROADS, RAILWAYS, POWER, WATER, COAL
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  recommendations EnrichmentRecommendation[]
  observations    EnrichmentObservation[]
  coverages       EnrichmentCoverage[]
}

model EnrichmentRecommendation {
  id                  String                   @id @default(uuid())
  projectId           String
  project             Project                  @relation(fields: [projectId], references: [id])
  featureCatalogId    String
  featureCatalog      EnrichmentFeatureCatalog @relation(fields: [featureCatalogId], references: [id])
  predictionId        String?
  triggerDriver       String
  reason              String
  currentDataGap      String
  targetRelevance     String
  priority            String // HIGH, MEDIUM, LOW
  feasibility         String // HIGH, MEDIUM, LOW
  recommendationScore Float                    @default(80.0)
  status              String                   @default("RECOMMENDED") // RECOMMENDED, ACCEPTED, REJECTED
  selected            Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  collectionPlans EnrichmentCollectionPlan[]
}

model EnrichmentCollectionPlan {
  id                   String                   @id @default(uuid())
  projectId            String
  project              Project                  @relation(fields: [projectId], references: [id])
  recommendationId     String
  recommendation       EnrichmentRecommendation @relation(fields: [recommendationId], references: [id])
  assignedRole         String // FIELD_OFFICER, CONTRACTOR, PROJECT_MANAGER
  assignedUserId       String?
  cadence              String // DAILY, WEEKLY, MONTHLY
  startDate            String
  endDate              String?
  expectedObservations Int                      @default(12)
  status               String                   @default("ACTIVE") // PENDING, ACTIVE, COMPLETED, PAUSED
  createdAt            DateTime                 @default(now())

  observations EnrichmentObservation[]
}

model EnrichmentObservation {
  id                 String                    @id @default(uuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id])
  featureCatalogId   String
  featureCatalog     EnrichmentFeatureCatalog  @relation(fields: [featureCatalogId], references: [id])
  collectionPlanId   String?
  collectionPlan     EnrichmentCollectionPlan? @relation(fields: [collectionPlanId], references: [id])
  collectorUserId    String
  observedAt         String
  valueNumeric       Float?
  valueText          String?
  valueBoolean       Boolean?
  valueJson          String?
  unit               String?
  source             String                    @default("FIELD_INSPECTION")
  evidenceUrl        String?
  remarks            String?
  verificationStatus String                    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy         String?
  verifiedAt         String?
  createdAt          DateTime                  @default(now())
}

model EnrichmentCoverage {
  id               String                   @id @default(uuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id])
  featureCatalogId String
  featureCatalog   EnrichmentFeatureCatalog @relation(fields: [featureCatalogId], references: [id])
  period           String
  expectedCount    Int                      @default(4)
  observedCount    Int                      @default(0)
  validCount       Int                      @default(0)
  missingCount     Int                      @default(4)
  coveragePercent  Float                    @default(0.0)
  updatedAt        DateTime                 @updatedAt
}

model EnrichmentEvaluation {
  id                    String   @id @default(uuid())
  evaluationName        String
  baselineModelVersion  String   @default("CUF-XGB-v1")
  candidateModelVersion String   @default("CUF-ENRICHED-XGB-v1-PILOT")
  target                String // RISK, COST, DELAY
  featureSet            String
  trainingWindow        String
  testWindow            String
  projectCount          Int
  observationCount      Int
  metricsJson           String
  deltaJson             String
  status                String   @default("LOCKED") // LOCKED, READY, COMPLETED
  createdAt             DateTime @default(now())
}
